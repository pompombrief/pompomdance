<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
// ===== バランス調整用パラメータ =====
const CFG={kSpeed:5.2,dSpeed:5.8,kHP:100,dmg:20,shots:5,bSpeed:58,fireCD:.45,mag:8,reload:1.7,
 fovCos:.5,viewDist:40,round:150,recover:2,aimBase:.03,aiAcc:.85,
 armorFrac:.2,healHP:40,healSan:40,stamMax:100,stamDrain:12,stamRegen:18,minStart:15,slowT:4,slowMul:.4,
 comboMax:20,comboSway:.09,stunT:3,glassesT:15,itemRespawn:25,boxPairs:20,mirrorPairs:2,mirrorMul:.8,failMul:.04,hitGrace:2.5,wakameT:15,healPairs:1,blindPairs:3,
 abilCD:60,abilT:3,abilRange:2.6,reviveSan:50,reviveHP:.5,healRegen:12,
 radarT:10,
 itemW:{radar:1,stun:1,wakame:1,armor:1,glasses:1.5},
 dances:[null,{A:2.2,w:4.2,drain:8,beat:.8,n:'初級'},{A:1.5,w:5,drain:16,beat:.6,n:'中級'},{A:.9,w:6,drain:30,beat:.45,n:'上級'}]};
CFG.dHP=CFG.dmg*CFG.shots; // ダンサーHP=弾5発分
const esc=t=>String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const angD=(a,b)=>{let d=a-b;while(d>Math.PI)d-=2*Math.PI;while(d<-Math.PI)d+=2*Math.PI;return d};
const cv=$('c'),R=new THREE.WebGLRenderer({canvas:cv,antialias:true});
const scene=new THREE.Scene();scene.background=new THREE.Color(0x0b0715);scene.fog=new THREE.Fog(0x0b0715,14,75);
const cam=new THREE.PerspectiveCamera(75,1,.1,150);cam.rotation.order='YXZ';scene.add(cam);
function resize(){R.setPixelRatio(Math.min(devicePixelRatio,2));R.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix()}
addEventListener('resize',resize);resize();
scene.add(new THREE.AmbientLight(0x7766bb,.9));
const sun=new THREE.DirectionalLight(0xffffff,.8);sun.position.set(20,40,10);scene.add(sun);
[[0xff2fd0,-20,0],[0x35f0ff,20,0],[0xffd24a,0,0]].forEach(([c,x,z])=>{const l=new THREE.PointLight(c,1.1,45);l.position.set(x,6,z);scene.add(l)});
const floor=new THREE.Mesh(new THREE.PlaneGeometry(72,72),new THREE.MeshLambertMaterial({color:0x140c2b}));floor.rotation.x=-Math.PI/2;scene.add(floor);
const grid=new THREE.GridHelper(72,36,0xff2fd0,0x2c1a5a);grid.position.y=.02;scene.add(grid);

// ===== フィールド =====
const statG=new THREE.Group(),rndG=new THREE.Group();scene.add(statG,rndG);const boxes=[];
function addBox(x,z,w,d,h,wall,col){boxes.push({x,z,w,d,h,wall,m:col===0x9fefff});
 const G=wall?statG:rndG,m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshLambertMaterial({color:col||(wall?0x1d1440:0x3a2670),emissive:col===0x9fefff?0x3a8aa0:0}));m.position.set(x,h/2,z);G.add(m);
 const e=new THREE.LineSegments(new THREE.EdgesGeometry(m.geometry),new THREE.LineBasicMaterial({color:h<1.8?0xffd24a:0x35f0ff}));e.position.copy(m.position);G.add(e)}
addBox(0,-35.5,72,1,4,1);addBox(0,35.5,72,1,4,1);addBox(-35.5,0,1,72,4,1);addBox(35.5,0,1,72,4,1);

const boxDist=(x,z,b)=>Math.hypot(Math.max(Math.abs(x-b.x)-b.w/2,0),Math.max(Math.abs(z-b.z)-b.d/2,0));
const free=(x,z,m)=>!boxes.some(b=>boxDist(x,z,b)<m);
const cover=[];
function genCover(){cover.length=0;boxes.filter(b=>!b.wall&&!b.m&&b.h>=2.5).forEach(b=>{for(let i=-1;i<=1;i++)for(let j=-1;j<=1;j++){if(!i&&!j)continue;const x=b.x+i*(b.w/2+1.4),z=b.z+j*(b.d/2+1.4);if(Math.abs(x)<32&&Math.abs(z)<32&&free(x,z,1))cover.push({x,z})}})}
const ovl=(a,b,m)=>Math.abs(a.x-b.x)<(a.w+b.w)/2+m&&Math.abs(a.z-b.z)<(a.d+b.d)/2+m;
function genMap(){rndG.clear();for(let i=boxes.length-1;i>=0;i--)if(!boxes[i].wall)boxes.splice(i,1);let n=0,tr=0;
 while(n<CFG.boxPairs&&tr++<2000){const tall=Math.random()<.7,hz=Math.random()<.5,L=2+Math.random()*(tall?6:5),T=tall?1.2+Math.random()*3:1.6+Math.random()*2.5,w=hz?L:T,d=hz?T:L,x=(Math.random()*2-1)*30,z=(Math.random()*2-1)*30,h=2.6+Math.random();
  const a={x,z,w,d},b={x:-x,z:-z,w,d};
  if(Math.abs(x)+w/2>33||Math.abs(z)+d/2>33||ovl(a,b,2.5)||[[-7,30],[7,30],[-7,-30],[7,-30]].some(([sx,sz])=>boxDist(sx,sz,a)<4||boxDist(sx,sz,b)<4)||boxes.some(o=>!o.wall&&(ovl(a,o,1.8)||ovl(b,o,1.8))))continue;
  addBox(x,z,w,d,h);addBox(-x,-z,w,d,h);n++}
 for(let i=0,t=0;i<CFG.mirrorPairs&&t++<300;){const hz=Math.random()<.5,x=(Math.random()*2-1)*26,z=(Math.random()*2-1)*24,w=hz?5:.3,d=hz?.3:5,a={x,z,w,d},b={x:-x,z:-z,w,d};
  if(ovl(a,b,3)||boxes.some(o=>!o.wall&&(ovl(a,o,1.8)||ovl(b,o,1.8)))||[[-7,30],[7,30],[-7,-30],[7,-30]].some(([sx,sz])=>boxDist(sx,sz,a)<4||boxDist(sx,sz,b)<4))continue;
  addBox(x,z,w,d,3,false,0x9fefff);addBox(-x,-z,w,d,3,false,0x9fefff);i++}
 genCover()}
// 鏡越しの視認（鏡の面で反射したダンサー像をキラーが見られるか）
function mirrorVia(k,d){let best=0;for(const m of boxes){if(!m.m)continue;const hz=m.w>m.d;let kx=k.x,kz=k.z,dx=d.x,dz=d.z,mx=m.x,mz=m.z,len=m.w,T=m.d;
  if(!hz){[kx,kz]=[kz,kx];[dx,dz]=[dz,dx];[mx,mz]=[mz,mx];len=m.d;T=m.w}
  const sg=Math.sign(kz-mz);if(!sg||(dz-mz)*sg<=0)continue;const pz=mz+sg*T/2,rz=2*pz-dz,t=(pz-kz)/(rz-kz);if(!(t>0&&t<1))continue;const hx=kx+t*(dx-kx);if(Math.abs(hx-mx)>len/2)continue;
  const hX=hz?hx:pz,hZ=hz?pz:hx,a1=Math.hypot(hX-k.x,hZ-k.z)||1,a2=Math.hypot(hX-d.x,hZ-d.z)||1,path=a1+a2;if(path>CFG.viewDist)continue;
  if((-(hX-k.x)*Math.sin(k.yaw)-(hZ-k.z)*Math.cos(k.yaw))/a1<CFG.fovCos)continue;
  if(!los(k.x,k.z,hX+(k.x-hX)/a1*.08,hZ+(k.z-hZ)/a1*.08)||!los(hX+(d.x-hX)/a2*.08,hZ+(d.z-hZ)/a2*.08,d.x,d.z))continue;
  best=Math.max(best,CFG.mirrorMul*(1.2-.6*path/CFG.viewDist))}return best}
// ===== アイテム =====
const itemG=new THREE.Group();scene.add(itemG);let items=[];
const BLIND={C:[{id:'stun',n:'スタン・トラップ!',f:e=>{e.stun=CFG.stunT}},{id:'radar',n:'レーダー（敵の位置を'+CFG.radarT+'秒表示）',f:e=>{e.radar=CFG.radarT}}],
 D:[{id:'wakame',n:'ワ◯メくんエキス',f:e=>{e.stamFree=CFG.wakameT}},{id:'armor',n:'アーマー',f:e=>{e.armor=CFG.dHP*CFG.armorFrac}}],
 K:[{id:'glasses',n:'ラブリーアイ',f:e=>{e.glasses=CFG.glassesT}}]};
function addItem(px,pz,kind){const hl=kind==='heal',m=new THREE.Mesh(new THREE.BoxGeometry(.8,.8,.8),new THREE.MeshLambertMaterial({color:hl?0x33ff88:0xffd24a,emissive:hl?0x118844:0x886600}));m.position.set(px,.8,pz);itemG.add(m);items.push({x:px,z:pz,kind,m,t:0,on:true})}
function placeItems(){itemG.clear();items=[];const pair=(kind,n)=>{for(let i=0,t=0;i<n&&t++<200;){const x=(Math.random()*2-1)*30,z=(Math.random()*2-1)*24;if(!free(x,z,1.8))continue;i++;
  [[x,z],[-x,-z]].forEach(([px,pz])=>addItem(px,pz,kind))}};
 pair('heal',CFG.healPairs);pair('blind',CFG.blindPairs)}
function pick(e,it){let n;if(it.kind==='heal'){if(e.team==='D')e.hp=Math.min(CFG.dHP,e.hp+CFG.healHP);else e.san=Math.min(100,e.san+CFG.healSan);n=e.team==='D'?'HP回復':'正気度回復'}
 else{const pl=[...BLIND.C,...BLIND[e.team]],tot=pl.reduce((s,x)=>s+CFG.itemW[x.id],0);let r=Math.random()*tot,c=pl[0];for(const x of pl){r-=CFG.itemW[x.id];if(r<=0){c=x;break}}c.f(e);n=c.n}
 it.on=false;it.m.visible=false;it.t=CFG.itemRespawn;if(e===viewE())say(n+' を入手!',2);snd(660,.15,'triangle',.15,300)}
function updItems(dt){for(const it of items){it.m.rotation.y+=dt*2;it.m.position.y=.8+Math.sin(tm*3)*.15;if(!it.on){it.t-=dt;if(it.t<=0){it.on=true;it.m.visible=true}continue}
 for(const e of ents)if(e.alive&&!e.insane&&Math.hypot(e.x-it.x,e.z-it.z)<1.1){pick(e,it);break}}}
function segBox(ax,az,bx,bz,b){let t0=0,t1=1;const o=[ax,az],d=[bx-ax,bz-az],mn=[b.x-b.w/2,b.z-b.d/2],mx=[b.x+b.w/2,b.z+b.d/2];
 for(let i=0;i<2;i++){if(Math.abs(d[i])<1e-9){if(o[i]<mn[i]||o[i]>mx[i])return false}else{let a=(mn[i]-o[i])/d[i],c=(mx[i]-o[i])/d[i];if(a>c)[a,c]=[c,a];t0=Math.max(t0,a);t1=Math.min(t1,c);if(t0>t1)return false}}return true}
const los=(ax,az,bx,bz)=>{for(const b of boxes)if(b.h>=1.8&&segBox(ax,az,bx,bz,b))return false;return true};
const RAD=.5;
function moveE(e,dx,dz){e.x+=dx;e.z+=dz;for(const b of boxes){const cx=clamp(e.x,b.x-b.w/2,b.x+b.w/2),cz=clamp(e.z,b.z-b.d/2,b.z+b.d/2),ox=e.x-cx,oz=e.z-cz,dd=Math.hypot(ox,oz);
 if(dd<RAD){if(dd>1e-6){e.x+=ox/dd*(RAD-dd);e.z+=oz/dd*(RAD-dd)}else e.z+=b.d/2+RAD}}e.x=clamp(e.x,-34,34);e.z=clamp(e.z,-34,34)}
function stepTo(e,tx,tz,sp,dt,face){sp*=e.slow>0?CFG.slowMul:1;const dx=tx-e.x,dz=tz-e.z,d=Math.hypot(dx,dz)||1;moveE(e,dx/d*sp*dt,dz/d*sp*dt);
 if(face)e.yaw+=clamp(angD(Math.atan2(-dx,-dz),e.yaw),-6*dt,6*dt);return d}

// ===== キャラクター =====
function makeChar(col,killer){const g=new THREE.Group(),m=new THREE.MeshLambertMaterial({color:col,emissive:0x000000});
 const body=new THREE.Mesh(new THREE.CylinderGeometry(.38,.38,1.3,10),m);body.position.y=.85;g.add(body);
 const head=new THREE.Mesh(new THREE.SphereGeometry(.27,12,10),new THREE.MeshLambertMaterial({color:killer?0xbbbbbb:0xffe0cc}));head.position.y=1.7;g.add(head);
 if(killer){const v=new THREE.Mesh(new THREE.BoxGeometry(.34,.08,.1),new THREE.MeshBasicMaterial({color:0xff2222}));v.position.set(0,1.72,-.24);g.add(v)}
 else{const h=new THREE.Mesh(new THREE.TorusGeometry(.25,.03,6,16),new THREE.MeshBasicMaterial({color:0xffee66}));h.position.y=2.05;h.rotation.x=Math.PI/2;g.add(h)}
 const arms=[-1,1].map(s=>{const a=new THREE.Group();a.position.set(s*.5,1.35,0);const b=new THREE.Mesh(new THREE.BoxGeometry(.16,.75,.16),m);b.position.y=-.35;a.add(b);g.add(a);return a});
 if(killer){const gn=new THREE.Mesh(new THREE.BoxGeometry(.1,.55,.1),new THREE.MeshLambertMaterial({color:0x222222}));gn.position.y=-.75;arms[1].add(gn)}
 g.userData={arms,m};return g}
const gunVM=new THREE.Mesh(new THREE.BoxGeometry(.1,.12,.6),new THREE.MeshLambertMaterial({color:0x333333}));gunVM.position.set(.3,-.25,-.6);cam.add(gunVM);
const net={on:false,host:false,client:false,peer:null,conns:[],conn:null,code:''};const bcast=m=>{if(net.mq&&net.host)mqPub('b',m);else net.conns.forEach(c=>c.open&&c.send(m))};
