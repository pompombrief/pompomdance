function leaveNet(){if(net.mq){const q=net.mq;try{if(net.host)q.publish(`dod/${net.room}/p`,'',{retain:true});else net.conn&&net.conn.send({t:'bye'})}catch(e){}setTimeout(()=>{try{q.end(true)}catch(e){}},300);net.mq=null}net.mqc={};clearTimeout(net.to);net.joined=false;try{net.peer&&net.peer.destroy()}catch(e){}net.on=net.host=net.client=false;net.conns=[];net.conn=null;net.peer=null}
function netErr(m){leaveNet();clearAll();P=null;state='menu';show('s-net');$('nt-msg').textContent=m}
function renderLobby(sl,fill,me,nm){$('lb-code').textContent=net.code;$('lb-list').innerHTML=sl.map((r,i)=>`<div class="chip" style="font-size:16px">${esc(nm&&nm[i]||'プレイヤー'+(i+1))}${i===me?'（あなた）':''}${i===0?' ★ホスト':''}：${r?ROLEN[r]:'<span style="opacity:.5">空き</span>'}</div>`).join('');
 $('lb-fill').checked=fill;$('lb-fill').disabled=!net.host;$('b-lbstart').classList.toggle('hide',!net.host)}
function lobBroadcast(){const sl=lob.slots.map(x=>x&&x.role),nm=lob.slots.map(x=>x&&x.name);net.conns.forEach(c=>c.open&&c.send({t:'L',s:sl,n:nm,f:lob.fill,me:lob.slots.findIndex(x=>x&&x.conn===c)}));renderLobby(sl,lob.fill,0,nm)}
function showLobby(){clearAll();P=null;state='lobby';show('s-lobby');renderLobby(lob.slots.map(x=>x&&x.role),lob.fill,0,lob.slots.map(x=>x&&x.name))}
function setRole(r){if(r==='R')r=Math.random()<.5?'D':'K';if(net.host){lob.slots[0].role=r;lobBroadcast()}else net.conn&&net.conn.send({t:'role',r})}
function makeHostP2P(){audio();if(typeof Peer==='undefined')return netErr('PeerJSを読み込めませんでした');leaveNet();net.host=net.on=true;lob={slots:[{role:'D',name:net.name},null,null,null],fill:true};$('nt-msg').textContent='部屋を作成中…';
 const A='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';net.code=Array.from({length:5},()=>A[Math.random()*A.length|0]).join('')+'P';
 const peer=net.peer=new Peer('dod-'+net.code,peerOpt());peer.on('open',showLobby);peer.on('disconnected',()=>{try{peer.reconnect()}catch(e){}});
 peer.on('error',er=>{if(er.type==='unavailable-id'){peer.destroy();makeHostP2P()}else netErr('接続エラー: '+er.type)});
 peer.on('connection',hostConn)}
function hostConn(c){const tm=setTimeout(()=>{if(!c.joinedSlot)try{c.close()}catch(e){}},8000);c.on('data',m=>onHost(c,m));c.on('error',()=>{});
  c.on('close',()=>{clearTimeout(tm);net.conns=net.conns.filter(x=>x!==c);const j=lob.slots.findIndex(x=>x&&x.conn===c);if(j>0)lob.slots[j]=null;if(c.ent){c.ent.human=false;c.ent.conn=null}if(state==='lobby')lobBroadcast()})}
// 名乗り(hello)を受けてから枠を確保。同じ端末の再接続は旧枠を置き換える
function admit(c,m){let x=lob.slots.find(x=>x&&x.conn===c);if(x){x.name=String(m.name||'').slice(0,12);lobBroadcast();return}
 const o=lob.slots.findIndex((x,i)=>i>0&&x&&x.uid===m.uid);if(o>0){const oc=lob.slots[o].conn;lob.slots[o]=null;net.conns=net.conns.filter(q=>q!==oc);try{oc.close()}catch(e){}}
 const i=lob.slots.findIndex(x=>!x);if(i<0||state!=='lobby'){c.send({t:'full',w:state!=='lobby'?'試合中のため参加できません':null});setTimeout(()=>{try{c.close()}catch(e){}},300);return}
 const n=r=>lob.slots.filter(x=>x&&x.role===r).length;lob.slots[i]={role:n('D')<=n('K')?'D':'K',conn:c,name:String(m.name||'').slice(0,12),uid:m.uid,seen:performance.now()};c.joinedSlot=true;net.conns.push(c);lobBroadcast()}
function onHost(c,m){const e=c.ent;const sx=lob.slots.find(x=>x&&x.conn===c);if(sx)sx.seen=performance.now();
 if(m.t==='hello')admit(c,m);else if(m.t==='bye')c.close();
 else if(m.t==='role'&&state==='lobby'&&(m.r==='D'||m.r==='K')){const x=lob.slots.find(x=>x&&x.conn===c);if(x){x.role=m.r;lobBroadcast()}}
 else if(m.t==='i'&&e&&e.inp)e.inp={f:+m.f||0,s:+m.s||0,md:m.md,yaw:+m.yaw||0,pitch:+m.pitch||0,combo:m.combo|0};
 else if(m.t==='dance'&&e&&e.alive&&!e.insane&&e.team==='D'){if(!m.n)e.dance=0;else if(e.stam>=CFG.minStart)startDance(e,m.n)}
 else if(m.t==='a'&&e){if(!useAbility(e))c.send({t:'say',s:'近くに蘇生できる味方がいません',d:1.4})}
 else if(m.t==='r'&&e&&e.ammo<CFG.mag&&e.rel<=0)e.rel=CFG.reload}
function joinRoom(code){audio();code=code.trim().toUpperCase();if(!code)return;if(/^[A-Z2-9]{5}[012]$/.test(code))return joinMq(code);if(typeof Peer==='undefined')return netErr('PeerJSを読み込めませんでした');leaveNet();net.on=net.client=true;net.code=code;
 net.joined=false;$('nt-msg').textContent='接続中…';const peer=net.peer=new Peer(undefined,peerOpt());net.to=setTimeout(()=>{if(net.client&&!net.joined)netErr('接続できませんでした。コードと通信環境を確認してください'+(net.local?'（ローカルモード：同じWi-Fi内か、ルーターのAP分離設定を確認してください）':''))},25000);peer.on('open',()=>{const c=net.conn=peer.connect('dod-'+code,{reliable:true});$('nt-msg').textContent='ルームを発見。P2P接続を確立中…';setTimeout(()=>{const pc=c.peerConnection;if(pc)pc.addEventListener('iceconnectionstatechange',()=>{if(pc.iceConnectionState==='failed'&&!net.joined)netErr('P2P接続に失敗しました。会社・学校Wi-Fiなど通信制限の可能性があります。別の回線でお試しください')})},0);c.on('open',()=>c.send({t:'hello',name:net.name,uid:UID}));c.on('error',()=>{});c.on('data',onClient);c.on('close',()=>{if(net.on)netErr('ホストとの接続が切れました')})});
 peer.on('error',er=>netErr(er.type==='peer-unavailable'?'ルームが見つかりません':'接続エラー: '+er.type))}
function onClient(m){net.lastRx=performance.now();if(m.t==='L'){if(state==='play'||state==='ending')return;if(state!=='lobby'){clearAll();P=null;state='lobby';show('s-lobby')}net.joined=true;renderLobby(m.s,m.f,m.me,m.n)}
 else if(m.t==='full')netErr(m.w||'ルームが満員です');else if(m.t==='start')netStart(m);else if(m.t==='S'&&P&&(state==='play'||state==='ending'))applySnap(m);
 else if(m.t==='say')say(m.s,m.d);else if(m.t==='end'&&state==='play'){state='ending';endT=1.8;P.win=m.w;P.why=m.why}}
function hostStart(){const sl=lob.slots.filter(Boolean),n=r=>sl.filter(x=>x.role===r).length;
 if(n('D')>2||n('K')>2)return $('lb-msg').textContent='各チーム2人までです。ロールを調整してください';
 if(!lob.fill){if(sl.length<2)return $('lb-msg').textContent='CPU補填なしの場合は、ホスト含め2人以上必要です';if(n('D')<1||n('K')<1)return $('lb-msg').textContent='各チームに最低1人必要です（ロール調整かCPU補填をオン）'}
 $('lb-msg').textContent='';startGame(null,sl.map(x=>({team:x.role,conn:x.conn,name:x.name})),lob.fill)}
$('b-net').onclick=()=>{audio();$('nt-msg').textContent='';show('s-net')};$('b-nback').onclick=()=>show('s-mode');
$('b-host').onclick=()=>{setName();makeHost()};$('b-join').onclick=()=>{setName();joinRoom($('nt-code').value)};try{$('nt-name').value=localStorage.getItem('dod-name')||''}catch(e){}
document.querySelectorAll('[data-lr]').forEach(b=>b.onclick=()=>setRole(b.dataset.lr));
$('lb-fill').onchange=()=>{if(net.host){lob.fill=$('lb-fill').checked;lobBroadcast()}};
$('b-lbstart').onclick=hostStart;$('b-lbleave').onclick=toTitle;
genMap();placeItems();let last=performance.now();
function loop(now){requestAnimationFrame(loop);const dt=Math.min(.05,(now-last)/1000);last=now;tm+=dt;
 if(state==='menu'||state==='lobby'){cam.position.set(Math.cos(tm*.12)*46,24,Math.sin(tm*.12)*46);cam.lookAt(0,0,0)}
 else{if((state==='play'||state==='ending')&&!paused){if(net.client)clientTick(dt);else if(intro>0){intro-=dt;if(intro<=0)say(role==='K'?'ダンサーを撃て!':'キラーの視界で踊れ!',2)}else update(dt)}
  animate(dt);updCam(dt);if(P)hud(paused?0:dt);drawRhythm();drawMini();if(net.host&&P&&(state==='play'||state==='ending')){snT-=dt;if(snT<=0){snT=net.mq?.066:.05;sendSnap()}}}
 R.render(scene,cam)}
requestAnimationFrame(loop);
</script></body></html>
